# Any random string you make up. Paste the same value into the Meta app's webhook settings.
VERIFY_TOKEN=pick-any-random-string

# From Meta app > Messenger > Messenger API Settings > Generate token (for your Page)
PAGE_ACCESS_TOKEN=

# From Meta app > App settings > Basic > App secret
APP_SECRET=

# Free API key from https://aistudio.google.com/apikey
LLM_API_KEY=

# Optional overrides (defaults shown). Any OpenAI-compatible API works, e.g. Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# SYSTEM_PROMPT=You are a friendly assistant for a Facebook Page. Keep replies short, clear and helpful.
